# _spinner <pid> [<msg>] - Show a spinner until the job with <pid> is finished
builtin emulate -L zsh

[[ -t 1 ]] || return
[[ -n "${1}" ]] || return 1

local -r \
	pid_arg="${1}" \
	msg_arg="${2}" \
	style_arg="${3:-$CYAN}"

local -ar spinners=('⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' '⠄⠆⠇⠋⠙⠸⠰⠠⠰⠸⠙⠋⠇⠆')
local -ar frames=(${(ws::)spinners[(($RANDOM%${#spinners[@]} + 1))]})
local -i i

while kill -0 "${pid_arg}" &> /dev/null; do
	printf "${CR}%s%s${NS} %s " \
		"${style_arg}" "${frames[((i++ % ${#frames[@]} + 1))]}" "${msg_arg}"
	sleep 0.042
done
