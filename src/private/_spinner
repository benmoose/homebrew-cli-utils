# _spinner <pid> [<msg>] - Show a spinner until the job with <pid> is finished
builtin emulate -L zsh

[[ -t 1 ]] || return
[[ -n "${1}" ]] || return 1

local -r \
	pid_arg="${1}" \
	msg_arg="${2}" \
	style_arg="${3:-$CYAN}"

local -ar spinners=('⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' '⠄⠆⠇⠋⠙⠸⠰⠠⠰⠸⠙⠋⠇⠆')
local -ir si=$((RANDOM%${#spinners[@]} + 1))
local -ar frames=( ${(ws::)spinner[$si]} )
local -i t

while kill -0 "${pid_arg}" &> /dev/null; do
	local -ir f=$((t++ % ${#frames[@]} + 1))
	printf "${CR}%s%s${NS} %s " "${style_arg}" "${frames[$f]}" "${msg_arg}"
	sleep 0.042
done
