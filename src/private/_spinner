# _spinner <pid> [<msg>] - Show a spinner until the job with <pid> is finished
builtin emulate -L zsh

[[ -t 1 ]] || return
[[ -n "${1}" ]] || return 1

local -r pid_arg="${1}" msg_arg="${2}" style_arg="${3:-${CYAN}}"
local -i i
local -ar \
	spinners=('⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏' '⠄⠆⠇⠋⠙⠸⠰⠠⠰⠸⠙⠋⠇⠆') \
	frames=(${(ws::)spinners[(($RANDOM%${#spinners[@]} + 1))]})

while kill -0 "${pid_arg}" &> /dev/null; do
	printf "${CR}%s${NS}%s %s " "${style_arg}" "${frames[((i % ${#frames[@]} + 1))]}" "${msg_arg}"
	((i++))
	sleep 0.042
done
