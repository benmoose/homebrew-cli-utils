# _spinner <pid> [<msg>] - Show a spinner until the job with <pid> is finished
#
# The environment variable `SPINNER` selects the spinners.txt line number to use,
# for the animation. If unset then a line is randomly chosen.
builtin emulate -L zsh

[[ -t 1 ]] || return
[[ -n "$1" ]] || return 1

local -ar spinners=( $(<"${CLI_UTILS_DIR}/share/cli-utils/spinners.txt") )
local -ir si=$(( ${SPINNER:-RANDOM} % $#spinners ))
local -ar frames=( "${(ws::)spinners[(( ++si ))]}" )
local -i t
local -r \
	pid_arg="$1" \
	msg_arg="${2-Thinking}"

{
	\tput civis
	while kill -0 "$pid_arg" &> /dev/null; do
		printf "${CR}${BOLD}${CYAN}%s${NS} %s$DIM...$NS " \
			"${frames[((t++ % ${#frames[@]} + 1))]}" "$msg_arg"
		sleep 0.042
	done
} always {
	echo "$(tput cnorm)"
}
