emulate -L zsh

if ! _git_repo; then return 1; fi

local -r main_b="$(_git_main_branch)" curr_b="$(_git_current_branch)"

if [[ "${curr_b}" != "${main_b}" ]]; then _err "$0: not on ${main_b} branch"; return 1; fi

setopt no_monitor

{ git fetch -q && git reset -q --hard "origin/${main_b}"; } & local -r pid="${!}"
trap 'kill "${pid}"; return 130'

local -r msg="reset to origin/${main_b}..."
_spinner "${pid}" "${msg}"

if wait "${pid}" 2>/dev/null; then
	printf "%s%s✓%s %s done\n" "${CR}${EL}" "${GREEN}" "${NS}" "${msg}"
else
	printf "%s%s×%s %s error\n" "${CR}${EL}" "${RED}" "${NS}" "${msg}"
	return 1
fi
