emulate -L zsh
set -o pipefail

if ! _git_repo; then return 1; fi
if ! which gh &>/dev/null; then _err "$0: command gh not found"; return 127; fi

declare -r _num=$(mktemp -q -t="${0}")

setopt no_monitor

gh pr view --json number --jq '.number' 2>/dev/null | cat >"${_num}" &!
gh pr view --web >/dev/null & declare -r pid="${!}"

trap 'kill "${pid}"; rm -f "${_num}"; return 130' INT TERM

_spinner "${pid}" "Opening pull request..."
if wait "${pid}" 2>/dev/null; then
	local num=$(<"${_num}")
	printf "%s%s✓%s Opened %s.\n" "${CR}${EL}" "${GREEN}" "${NS}" "${num:+#}${num:-pull request}"
fi

rm -f "${_num}"
