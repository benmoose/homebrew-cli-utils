# vpr - View the pull request belonging to the current branch on GitHub

emulate -L zsh

if ! _git_repo; then return 1; fi
if ! which gh &>/dev/null; then _err "$0: command gh not found"; return 127; fi

setopt no_monitor

local -r msg="Open pull request..." \
	_err=$(mktemp -q -t="${0}")

gh pr view --web 2> "${_err}" > /dev/null & local -r pid="${!}"
trap 'kill "${pid}"; rm -f "${_err}"; return 130' INT TERM
trap 'rm -f "${_err}"' EXIT

_spinner "${pid}" "${msg}"

if ! wait "${pid}" 2>/dev/null; then
	printf "${CR}${EL}"
	local -r _errmsg=$(<${_err})
	_err "${0}: ${_errmsg:0:1:u}${_errmsg:1}"
	return 1
fi

printf "${CR}${EL}%s %s done\n" "${BOLD}${GREEN}✓${NS}" "${msg}"
