emulate -L zsh
set -o pipefail

if ! _git_repo; then return 1; fi
if ! git show-ref --exists --no-tags --no-head --quiet refs/remotes/origin/staging; then
	_err "$0: origin/staging does not exist"
fi

local -r main_b="$(_git_main_branch)" curr_b="$(_git_current_branch)"

if [[ -z "${curr_b}" || "${curr_b}" == "staging" || "${curr_b}" == "${main_b}" ]]; then
	_err "$0: not on feature branch"
	return 1
fi

local -r _err=$(mktemp -q -t "${0}") \
	msg="Staging ${curr_b}..."

{ trap 'git checkout -q "${curr_b}"' INT TERM ERR
	git checkout -q staging && \
		git fetch -q && \
		git reset -q --hard origin/staging && \
		git merge -q --no-edit "${curr_b}" && \
		git push -q origin staging && \
		git checkout -q "${curr_b}"; } 2>"${_err}" & local -r pid="${!}"
trap 'kill "${pid}"; rm -f "${_err}"; return 130' INT TERM

_spinner "${pid}" "${msg}"

if wait "${pid}" 2>/dev/null; then
	printf "%s%s✓%s %s done\n" "${CR}${EL}" "${GREEN}" "${NS}" "${msg}"
else
	printf "%s%s×%s %s error\n" "${CR}${EL}" "${RED}" "${NS}" "${msg}"
	if [[ -e "${_err}" && -s "${_err}" ]]; then
		while read -r line; do
			printf "  %s%s%s\n" "${DIM}" "${line}" "${NS}"
		done < <"${_err}"
	fi
	return 1
fi

rm -f "${_err}"
