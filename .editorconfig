# EditorConfig https://editorconfig.org
root = true

[*]
end_of_line               = lf
indent_size               = 2
indent_style              = space
insert_final_newline      = true
trim_trailing_whitespace  = true

[Makefile]
indent_size   = 4
indent_style  = tab

[src/**/*]
indent_size         = 4
indent_style        = tab
shell_variant       = zsh
switch_case_indent  = true

[*.rb]
indent_size = 4
