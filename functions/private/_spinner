# shellcheck shell=bash

declare -r pid_arg="${1}" msg_arg="${2}" style_arg="${3:-${CYAN}}"
declare -ar frames=("⠄" "⠆" "⠇" "⠋" "⠙" "⠸" "⠰" "⠠" "⠰" "⠸" "⠙" "⠋" "⠇" "⠆")
declare -i i

printf "${CIVIS}"
trap 'printf "${CNORM}"' EXIT ERR

while kill -0 "${pid_arg}" 2> /dev/null; do
	printf "${CR}%s%s${NS} %s " "${style_arg}" "${frames[$((i % ${#frames[@]} + 1))]}" "${msg_arg}"
	((i++))
	sleep 0.045
done
