# shellcheck shell=bash

declare -r pid_arg="${1}" msg_arg="${2}" style_arg="${3:-${CYAN}}"
declare -ar frames=("⠄" "⠆" "⠇" "⠋" "⠙" "⠸" "⠰" "⠠" "⠰" "⠸" "⠙" "⠋" "⠇" "⠆")
declare -i i

while kill -0 "${pid_arg}" 2> /dev/null; do
	printf "%s%s%s%s %s " "${CR}" "${style_arg}" "${frames[$((i % ${#frames[@]} + 1))]}" "${NS}" "${msg_arg}"
	((i++))
	sleep 0.045
done
