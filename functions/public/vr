# shellcheck shell=bash
if ! _git_repo; then return 1; fi
if ! which gh &>/dev/null; then _err "$0: command gh not found"; return 127; fi

setopt LOCAL_OPTIONS LOCAL_TRAPS NO_MONITOR

local -r branch_arg="${1:-$(_git_current_branch)}"

(gh repo view --branch "${branch_arg}" --web) >/dev/null & local -r pid="${!}"
trap 'kill "${pid}"; return 130' INT TERM

_spinner "${pid}" "Opening repository... "

if wait "${pid}" 2>/dev/null; then printf "${CR}${EL}"; fi
