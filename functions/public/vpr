# shellcheck shell=bash
if ! _is_git_repo; then return 1; fi
if ! which gh &>/dev/null; then _err "$0: command gh not found"; return 127; fi

setopt LOCAL_OPTIONS LOCAL_TRAPS NO_MONITOR

(gh pr view --web) >/dev/null & local pid="${!}"
trap 'kill "${pid}"; return 130' INT TERM

local num msg
num=$(gh pr view --json number --jq '.number')
msg="Opening pull request #${num}... "

_spinner "${pid}" "${msg}" "$(tput setaf 4)"
if wait "${pid}" 2>/dev/null; then
	printf "%s%s✓%s %s done.\n" "${CR}${EL}" "${GREEN}" "${NS}" "${msg}"
fi
